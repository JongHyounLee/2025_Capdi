/* syscalls.c */

#include <sys/stat.h>
#include <errno.h>

/* HAL, UART 헤더 */
#include "stm32h7xx_hal.h"
#include "stm32h7xx_hal_uart.h"

/* UART4 핸들 (다른 곳에서 정의됨) */
extern UART_HandleTypeDef huart5;

/* 표준 입출력용 약한 심볼 (scanf 등에서 사용 가능) */
extern int __io_putchar(int ch) __attribute__((weak));
extern int __io_getchar(void) __attribute__((weak));

/* ========== printf / puts 등 → UART4로 리다이렉트 ========== */
int _write(int file, char *ptr, int len)
{
    (void)file;  // stdout(1), stderr(2) 구분 안 하고 전부 UART4로

    HAL_StatusTypeDef st =
        HAL_UART_Transmit(&huart5, (uint8_t *)ptr, (uint16_t)len, HAL_MAX_DELAY);

    if (st == HAL_OK)
    {
        return len;
    }
    else
    {
        errno = EIO;
        return -1;
    }
}

/* ========== 나머지 syscall 들: 기본 ST 템플릿 수준의 stub ========== */

char *__env[1] = { 0 };
char **environ = __env;

void initialise_monitor_handles(void)
{
}

/* 프로세스/시그널 관련 (실제 RTOS 환경에선 의미 없음, 그냥 stub) */
int _getpid(void)
{
    return 1;
}

int _kill(int pid, int sig)
{
    (void)pid;
    (void)sig;
    errno = EINVAL;
    return -1;
}

void _exit (int status)
{
  _kill(status, -1);
  while (1) { }    /* 여기에 멈춤 */
}

/* scanf 등의 입력용 (안 쓰면 그대로 둬도 됨) */
__attribute__((weak))
int _read(int file, char *ptr, int len)
{
  (void)file;
  int DataIdx;

  for (DataIdx = 0; DataIdx < len; DataIdx++)
  {
    *ptr++ = __io_getchar();
  }

  return len;
}

int _close(int file)
{
  (void)file;
  return -1;
}

int _fstat(int file, struct stat *st)
{
  (void)file;
  st->st_mode = S_IFCHR;
  return 0;
}

int _isatty(int file)
{
  (void)file;
  return 1;
}

int _lseek(int file, int ptr, int dir)
{
  (void)file;
  (void)ptr;
  (void)dir;
  return 0;
}

int _open(char *path, int flags, ...)
{
  (void)path;
  (void)flags;
  /* 항상 실패했다고 가정 */
  return -1;
}

int _wait(int *status)
{
  (void)status;
  errno = ECHILD;
  return -1;
}

int _unlink(char *name)
{
  (void)name;
  errno = ENOENT;
  return -1;
}

int _stat(char *file, struct stat *st)
{
  (void)file;
  st->st_mode = S_IFCHR;
  return 0;
}

int _link(char *old, char *new)
{
  (void)old;
  (void)new;
  errno = EMLINK;
  return -1;
}

int _fork(void)
{
  errno = EAGAIN;
  return -1;
}

int _execve(char *name, char **argv, char **env)
{
  (void)name;
  (void)argv;
  (void)env;
  errno = ENOMEM;
  return -1;
}
